filters:
  and:
    - '!file.name.contains("Template")'
views:
  - type: table
    name: Tabla
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    name: Categories
    filters:
      and:
        - file.tags.contains("categories")
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 203
    cardSize: 330
    imageAspectRatio: 1
